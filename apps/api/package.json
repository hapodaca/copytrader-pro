{
  "name": "@copytrader/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev --schema=src/db/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=src/db/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=src/db/prisma/schema.prisma",
    "db:seed": "tsx src/db/seed.ts",
    "db:push": "prisma db push --schema=src/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.57",
    "@prisma/client": "^5.10.0",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.7",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.10.0",
    "nodemailer": "^8.0.2",
    "ws": "^8.16.0",
    "yahoo-finance2": "^2.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^7.0.11",
    "@types/ws": "^8.5.10",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
