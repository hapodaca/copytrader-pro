# ─────────────────────────────────────────────
# SUPABASE (obtener en supabase.com → Settings)
# ─────────────────────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Settings → Database → Connection string → Transaction mode (para queries)
DATABASE_URL=postgresql://postgres.xxxx:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Settings → Database → Connection string → Session mode (para migraciones Prisma)
DIRECT_URL=postgresql://postgres.xxxx:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ─────────────────────────────────────────────
# REDIS LOCAL (ya corre con n8n en puerto 6379)
# ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────────
# TRADOVATE (registrar app en tradovate.com)
# ─────────────────────────────────────────────
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0.0
TRADOVATE_CLIENT_ID=
TRADOVATE_CLIENT_SECRET=
TRADOVATE_REDIRECT_URI=http://localhost:3001/api/auth/tradovate/callback

# ─────────────────────────────────────────────
# WEBHOOK SEGURIDAD
# ─────────────────────────────────────────────
WEBHOOK_SECRET=cambiar_por_secreto_seguro
TV_ALLOWED_IPS=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7

# ─────────────────────────────────────────────
# NOTIFICACIONES EMAIL (opcional — dejar vacío para deshabilitar)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=app_password_aqui
SMTP_FROM=CopyTrader Pro <tu@gmail.com>

# ─────────────────────────────────────────────
# NOTIFICACIONES TELEGRAM (opcional)
# Crear bot con @BotFather → obtener token
# El usuario envía /start al bot → obtener chat_id
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:3000

# Token del túnel de Cloudflare (PM2 → synctrade-tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# ─────────────────────────────────────────────
# FRONTEND (copiar también en apps/web/.env.local)
# ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

WEBHOOK_DIAGNOSTIC=0
